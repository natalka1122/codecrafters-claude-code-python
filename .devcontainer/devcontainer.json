{
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "postStartCommand": "bash .devcontainer/post_start_command.sh",
    "mounts": [
        "source=${localEnv:GITHUB_SSH_DIR},target=/home/vscode/.ssh,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "TZ": "Europe/Budapest",
        "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
        "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "ryu1kn.partial-diff",
                "NicolasVuillamy.vscode-groovy-lint",
                "ms-python.mypy-type-checker",
                "ms-python.flake8"
            ],
            "settings": {
                "remote.localPortHost": "allInterfaces",
                "remote.autoForwardPorts": false,
                "mypy-type-checker.args": [
                    "--check-untyped-defs",
                    "--strict",
                    "--follow-untyped-imports"
                ],
                "mypy-type-checker.executable": "/usr/local/bin/mypy",
                "python.analysis.diagnosticSeverityOverrides": {
                    "reportUnusedImport": "warning",
                    "reportUnusedVariable": "warning"
                },
                "python.analysis.typeCheckingMode": "strict",
                "python.analysis.languageServerMode": "full"
            }
        }
    }
}